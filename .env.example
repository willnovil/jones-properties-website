# RentCafe API V2 Configuration
# Use EITHER companyCode (preferred) OR apiToken — not both

# Company Code (found in RentCafe Site Manager → Settings → Company Information)
# Format: c + digits, e.g., c00000012345
RENTCAFE_COMPANY_CODE=your_company_code_here

# Vendor API Token (only if using a registered vendor token)
RENTCAFE_API_TOKEN=your_api_token_here

# Property Code(s) — found under Properties in RentCafe Site Manager
# Format: p + digits, e.g., p0485440
# Comma-separated if multiple: p0485440,p0485441,p0485442
RENTCAFE_PROPERTY_CODE=your_property_code_here

# RentCafe Tenant Portal URL
RENTCAFE_PORTAL_URL=https://www.rentcafe.com/residents/jonesproperties

# Optional: Google Maps API Key for embedded maps
GOOGLE_MAPS_API_KEY=
